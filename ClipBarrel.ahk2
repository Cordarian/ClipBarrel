; =========================================================
; DIRECTIVES
; =========================================================
#Requires Autohotkey v2.0+
#SingleInstance Force ; Prevents multiple versions of script running
#UseHook true ; Helps ensure modifier keys don't remain pressed after hotkey ends
OnClipboardChange ClipChanged

; =========================================================
; VARIABLES
; =========================================================
Global Cliptionary := Map()
/*
Cliptionary shape:
Cliptionary[line_key] := {clip_text, clip_all}
*/
Global A_Return := "`r`n"
Global prior_paste := A_Return
Global this_paste := ClipboardAll()
Global alphabet := "abcdefghijklmnopqrstuvwxyz"
Global A_Tab_Spaces := A_Space A_Space A_Space A_Space

Global line_text_header := "Line text" A_Tab_Spaces A_Tab_Spaces A_Tab_Spaces A_Tab_Spaces A_Tab_Spaces
Global alpha_reverse := False
Global copy_reverse := True
Global stream_fallback := "Settings-" A_Username ".ini"

; GUI constants -------------------------------------------
Global fontPoint := 10
Global MarginX := fontPoint * 1.25 ; MarginX is 1.25 fontsize
Global marginY := fontPoint * 0.75 ; MarginY is .75 fontsize
Global lineHeight := fontPoint * 1.33 + marginY ; Font point to pixel conversion is *1.33
Global headerHeight := lineHeight + fontPoint * 1.25 ; The header seems to get extra margin?
Global LV_max := 10 * lineHeight + headerHeight
Global transparency_level := 150


; =========================================================
; HOTKEYS
; =========================================================
#HotIf ; Universal hotkeys

; ClipBarrel copy
#c::
{
	new_key := Copy2ClipBarrel("copy", 2) ; Copies selected text
	If !WinExist("ClipBarrel - ") { ; Creates the ClipBarrel GUI if it doesn't already exist
		ClipBarrelInitialize()
		LoadClipBarrelLV([
			new_key
		])
	}
	Else { ; If the GUI does exist, just adds the copied text to ClipBarrel
		LoadClipBarrelLV([
			new_key
		])
	}
}

; ClipBarrel cut
#x::
{
	new_key := Copy2ClipBarrel("cut", 2) ; Copies selected text
	If !WinExist("ClipBarrel - ") { ; Creates the ClipBarrel GUI if it doesn't already exist
		ClipBarrelInitialize()
		LoadClipBarrelLV([
			new_key
		])
	}
	Else { ; If the GUI does exist, just adds the copied text to ClipBarrel
		LoadClipBarrelLV([
			new_key
		])
	}
}

; Pastes the previous clipboard
#z::{
	Global
	Local clip_holder := [
		this_paste,
		prior_paste
	]
	Load_Clipboard(prior_paste)
	Global ClipBarrel_Paste := prior_paste

	Send("^v")
	prior_paste := clip_holder[1]
	this_paste := clip_holder[2]
}


#HotIf WinExist("ClipBarrel - Next Line: ") ; ClipBarrel only
#v::
; ClipBarrel paste
{
	Paste_Selection()
	selected_row_data := RetrieveSelectedRows()
	row_to_focus := DeleteClip(selected_row_data) ; Removes the pasted item from ClipBarrel
	Select_row(row_to_focus)

}

; Text-only paste
!#v::
{
	Paste_Selection(text_only := True)
	selected_row_data := RetrieveSelectedRows()
	row_to_focus := DeleteClip(selected_row_data) ; Removes the pasted item from ClipBarrel
	Select_row(row_to_focus)
}

; Paste entire barrel
^#v::
{
	ClipListView.Modify(0, "Select")
	Paste_Selection()
	Cliptionary := Map()
	ClipBarrel_Destroy()
}

; Paste without removing item from barrel (nondestructive)
#b::
{
	RetrieveSelectedRows()
	Paste_Selection()
	current_focus := ClipListView.GetNext(, "Focus")
	ClipListView.Modify(0, "-Focus -Select") ; De-selects all rows
	ClipListView.Modify(current_focus + 1, "Focus Select") ; Advances the focused/selected row for next paste
	Global this_focus := current_focus
}

; Nondestructive text-only paste
!#b::
{
	RetrieveSelectedRows()
	Paste_Selection(text_only := True)
	current_focus := ClipListView.GetNext(, "Focus")
	ClipListView.Modify(0, "-Focus -Select") ; De-selects all rows
	ClipListView.Modify(current_focus + 1, "Focus Select") ; Advances the focused/selected row for next paste
	Global this_focus := current_focus
}

; Nondestructive paste entire barrel
^#b::
{
	ClipListView.Modify(0, "Select")
	Paste_Selection()
	current_focus := ClipListView.GetNext(, "Focus")
	ClipListView.Modify(0, "-Focus -Select") ; De-selects all rows
	ClipListView.Modify(current_focus + 1, "Focus Select") ; Advances the focused/selected row for next paste
	Global this_focus := current_focus
}

; Pastes the ClipBarrel item at the list position of the hotkey number
#1::
#Numpad1::
#2::
#Numpad2::
#3::
#Numpad3::
#4::
#Numpad4::
#5::
#Numpad5::
#6::
#Numpad6::
#7::
#Numpad7::
#8::
#Numpad8::
#9::
#Numpad9::
#0::
#Numpad0::
{
	Global
	Local paste_num := Integer(SubStr(A_ThisHotkey, -1)) ; Gets the number used in the hotkey
	If (paste_num = 0) {
		paste_num := 10
	}
	If paste_num > ClipListView.GetCount() {
		ToolTip(Format("No clip in position {}", paste_num)), SetTimer(ToolTip, -2000)
		Return
	}
	ClipListView.Modify(paste_num, "Focus Select") ; Focuses the item in the list with Win# = paste_num
	Select_row(paste_num)
	Paste_Selection()
}

#HotIf WinExist("ClipBarrel - ClipCounter: ") ; ClipCounter only
; ClipCounter paste
#v::ClipCounter_Paste()


#HotIf !WinExist("ClipBarrel - ") ; If ClipBarrel isn't active
; Normal paste in case user tries #v without actually copying anything to ClipBarrel
#v::Send("^v")
#HotIf


; =========================================================
; FUNCTIONS
; =========================================================
; GENERAL =================================================
ClipSave(duration := 1)
; Stores the current clipboard for later restoration
{
	Global ClipChange ; This comment prevents line formatting
	ClipChange := ""
	Global ClipSaveText
	ClipSaveText := A_Clipboard
	A_Clipboard := ""
	ClipLoop(duration, , 25) ; Waits for the clipboard to receive the new text
}

ClipRestore(duration := 1)
; Restores the saved clipboard from ClipSave
{
	Sleep(200) ; To prevent restoring the clipboard before the previous line has finished pasting
	Global ClipChange
	ClipChange := ""
	Global ClipSaveText
	A_Clipboard := ClipSaveText ; Restores the saved clipboard
	ClipLoop(duration, , 25) ; Waits for the clipboard to receive the new text
}

ClipLoop(duration := 1, displaytext := "Oops", increment := 15)
; Loops until the clipboard receives the text sent by other functions
{
	Global ClipChange ; This comment prevents line formatting
	cycle := 0
	Loop {
		ListLines(false)
		If (ClipChange = True) {
			ClipChange := "" ; Resets ClipChange on success
			ListLines(true)
			Return
		}
		cycle := cycle + 0.1
		Sleep(increment)
		If (cycle > duration) ; Timeout
		{
			Tip(displaytext)
			Send("{Alt Up}")
			ListLines(true)
			Exit()
		}
	}
}

ClipChanged(DataType) {
	; Tells calling functions when the clipboard has received new text. Also saves the old clipboard each time it's changed for use with ClipBarrel
	Global

	; ClipBarrel prior_paste
	this_paste := this_paste ?? 0
	prior_paste := prior_paste ?? 0
	If !(prior_paste = A_Clipboard or this_paste = A_Clipboard) {
		prior_paste := this_paste
	}
	this_paste := A_Clipboard
	ClipChange := True
}

Tip(tiptext := "Tip", sec := 2)
; Displays a tooltip for (default) 2 seconds
{
	ToolTip(tiptext), SetTimer(ToolTip, -1000 * sec)
}

Create_Image(B64, NewHandle := True) {
	; Seems to work better with ICO files than PNG
	; This function adapted from Image2Include v2 by iPhilip https://www.autohotkey.com/boards/viewtopic.php?style=1&t=119966
	Static hBitmap := 0
	If (NewHandle)
		hBitmap := 0
	If (hBitmap)
		Return hBitmap

	If !DllCall("Crypt32.dll\CryptStringToBinary", "Ptr", StrPtr(B64), "UInt", 0, "UInt", 0x01, "Ptr", 0, "UIntP", &DecLen :=
	0, "Ptr", 0, "Ptr", 0)
		Return False
	Dec := Buffer(DecLen, 0)
	If !DllCall("Crypt32.dll\CryptStringToBinary", "Ptr", StrPtr(B64), "UInt", 0, "UInt", 0x01, "Ptr", Dec, "UIntP", &
	DecLen, "Ptr", 0, "Ptr", 0)
		Return False
	; Bitmap creation adopted from "How to convert Image data (JPEG/PNG/GIF) to hBITMAP?" by SKAN
	; -> http://www.autohotkey.com/board/topic/21213-how-to-convert-image-data-jpegpnggif-to-hbitmap/?p=139257
	hData := DllCall("Kernel32.dll\GlobalAlloc", "UInt", 2, "UPtr", DecLen, "UPtr")
	pData := DllCall("Kernel32.dll\GlobalLock", "Ptr", hData, "UPtr")
	DllCall("Kernel32.dll\RtlMoveMemory", "Ptr", pData, "Ptr", Dec, "UPtr", DecLen)
	DllCall("Kernel32.dll\GlobalUnlock", "Ptr", hData)
	DllCall("Ole32.dll\CreateStreamOnHGlobal", "Ptr", hData, "Int", True, "PtrP", pStream := ComValue(13, 0))
	hGdip := DllCall("Kernel32.dll\LoadLibrary", "Str", "Gdiplus.dll", "UPtr")
	SI := Buffer(8 + 2 * A_PtrSize, 0), NumPut("UInt", 1, SI, 0)
	DllCall("Gdiplus.dll\GdiplusStartup", "PtrP", &pToken := 0, "Ptr", SI, "Ptr", 0)
	DllCall("Gdiplus.dll\GdipCreateBitmapFromStream", "Ptr", pStream, "PtrP", &pBitmap := 0)
	DllCall("Gdiplus.dll\GdipCreateHBITMAPFromBitmap", "Ptr", pBitmap, "PtrP", &hBitmap := 0, "UInt", 0)
	DllCall("Gdiplus.dll\GdipDisposeImage", "Ptr", pBitmap)
	DllCall("Gdiplus.dll\GdiplusShutdown", "Ptr", pToken)
	DllCall("Kernel32.dll\FreeLibrary", "Ptr", hGdip)
	Return hBitmap
}

StreamRead(INI_section, INI_key, defaultTo := False) {
	; Reads the key's value from the given section of the data stream
	stream_value := IniRead(A_ScriptFullPath ":Stream:$DATA", INI_section, INI_key, defaultTo)
	If stream_value = defaultTo {
		Global stream_fallback
		stream_value := IniRead(stream_fallback, INI_section, INI_key, defaultTo)
	}
	Return stream_value
}

StreamWrite(INI_section, INI_key, INI_value) {
	; Writes the value to the key
	; This will fail if the file isn't in an NTFS folder, E.G., if it's in Box Drive, which is FAT-32
	Try {
		IniWrite(INI_value, A_ScriptFullPath ":Stream:$DATA", INI_section, INI_key)
	}
	Catch {
		Global stream_fallback
		IniWrite(INI_value, stream_fallback, INI_section, INI_key)
	}
}


; CLIPBARREL FUNCTIONS ====================================
/**
 * 
 * @param mode String; "cut" or "copy", depending on whether to send ^x or ^c
 * @param duration Int; number of seconds to wait before timing out
 * @param displaytext String; message to display to user on a failed copy/cut
 * @Return clip_key String; Cliptionary key for the copied clipboard
 */
Copy2ClipBarrel(mode, duration := 1)
; Copies/cuts selected text to ClipBarrel
{
	ClipSave() ; Saves the existing clipboard for later restoration
	Global ClipChange := "" ; Tracks when the clipboard actually receives cliptext
	Global Cliptionary
	If (mode = "cut") {
		Send("{Ctrl Down}x{Ctrl Up}") ; Explicitly using down/up events seems to help prevent modifier keys from sticking down
	}
	Else ; Copy
	{
		Send("{Ctrl Down}c{Ctrl Up}")
	}

	reset_sort()
	Local cycle := 0
	Loop ; Waits for the clipboard to receive cliptext before proceeding
	{
		If (ClipChange = True) {
			ClipChange := "" ; Resets ClipChange on success
			Break
		}
		cycle := cycle + 0.1
		Sleep(15)
		If (cycle > duration) ; Timeout
		{
			Send("{Alt Up}")
			A_Clipboard := "" ; Prevents previous clipboard from entering the listview
			Break
		}
	}

	this_clip := ClipboardAll()
	clip_key := "Clip_" this_clip.Ptr ; Creates a unique identifier from the ClipboardAll pointer

	display_text := A_Clipboard ; Saves a plain-text version of the clipboard to display in the LV
	If (StrLen(A_Clipboard) = 0 AND this_clip.Size != 0) {
		; If A_Clipboard has non-text data, StrLen will be 0, but the size won't be 0
		display_text := "{object: " this_clip.Ptr "}"
	}

	; clip_key is a unique identifier for the item
	; clip_text is a plain-text version of clip_all for display in the LV
	; clip_all is the complete version of the clipboard
	Cliptionary[clip_key] := {
		clip_text: display_text,
		Clip_All: this_clip
	}

	ClipRestore() ; Should restore the clipboard for the default Windows paste. Not convinced that happens in all instances, but I tried
	Return clip_key
}


/**
 * Adds clipboard text to the listview
 * @param key_array Array of strings; Array of Cliptionary keys to the items to add to ClipListView 
 */
LoadClipBarrelLV(key_array) {
	Global
	focused_row := ClipListView.GetNext(, "Focus")

	; If no row is focused, add to bottom of list
	If focused_row = 0 {
		insert_below := ClipListView.GetCount()
	}
	; Otherwise, add beneath focused row
	Else insert_below := focused_row

	; Loops through multiple items for Split Lines button
	Loop key_array.Length {
		this_key := key_array[A_index]

		this_text := Cliptionary[this_key].clip_text
		ClipListView.Insert(insert_below + A_Index, "Icon" insert_below + A_Index, this_text, this_key, "")
	}

	; De-selects all rows
	ClipListView.Modify(0, "-Focus -Select")
	; If a row was previously focused, advances that focus; otherwise, it remains unfocused so new copies are inserted at the end of the LV
	If focused_row {
		ClipListView.Modify(focused_row + 1, "Focus Select")
	}

	LV_Grow() ; Resizes GUI
	ClipRestore()
}

/**
 * Returns a map of selected rows.
 * Map shape:
 * {focused_ID: The row number of the currently focused row, ID_array: Array of selected row numbers, key_array: Array of selected row keys}
 **/
RetrieveSelectedRows(*) {
	Global ClipListView
	selected_row_IDs := []
	selected_keys := []
	RowNumber := 0 ; Starts searching at the top of the list
	Loop {
		RowNumber := ClipListView.GetNext(RowNumber) ; Resumes search after the previous loop's row

		If not RowNumber {
			; If there's no selected row the first loop through, selects the first
			If A_Index = 1 {
				ClipListView.Modify(1, "Focus Select")
				RowNumber := 1
			}
			; Otherwise, we've looped through all selected rows
			Else {
				Break
			}
		}
		selected_row_IDs.Push(RowNumber)
		Try {
			selected_keys.Push(ClipListView.GetText(RowNumber, 2))
		}
	}

	; Gets focused row to select after paste
	focused_row := ClipListView.GetNext(, "Focus")

	; Loads data into the row_map
	row_map := Map("focused_ID", focused_row, "ID_array", selected_row_IDs, "key_array", selected_keys)

	; Updates next line in GUI title
	next_line := ClipListView.GetText(focused_row, 1)
	ClipBarrel.Title := Format("ClipBarrel - Next Line: {}", next_line)

	Return row_map
}

/**
 * 
 * @param current_row Int; row number of the current LV selection
 */
Select_row(row_number) {
	; Won't select a row if none was previously selected
	If row_number > 0 {
		ClipListView.Modify(0, "-Select -Focus") ; Deselects all rows to prevent ambiguity from multi-selecting
		If row_number > ClipListView.GetCount() {
			ClipListView.Modify(1, "Focus Select") ; Loops around to the top of the LV
		}
		Else ClipListView.Modify(row_number, "Focus Select") ; Selects the next item for the next paste
		RetrieveSelectedRows(row_number) ; Added 12/31/25 'cause pasting by number wasn't selecting anything; likely inefficient since we aren't using the return value
	}
}


/* ClipBarrel paste without removing the pasted item from the barrel */
Paste_Selection(text_only := False) {
	Global
	selected_row_data := RetrieveSelectedRows()
	For key in selected_row_data["key_array"] {
		If A_Index > 1 {
			Send("{Enter}") ; Ensures multiple pastes all end up on their own lines
		}
		If text_only {
			paste_clip := Cliptionary[key].clip_text
		}
		Else {
			paste_clip := Cliptionary[key].clip_all
		}
		Load_Clipboard(paste_clip)
		Send("^v") ; Pastes
		Sleep 250 ; Seems to need a rest or it tries to paste too quickly and nothing happens
	}
	Global ClipBarrel_Paste := ClipboardAll()
	ClipRestore()
}

/**
 *  Sends Clip_All to the clipboard, then waits for it to be received before proceeding
 * @param Clip_All ClipboardAll object
 */
Load_Clipboard(Clip_All, duration := 2, displaytext := "Oops") {
	ClipSave() ; Saves the existing clipboard for later restoration
	Global ClipChange
	ClipChange := "" ; Tracks when the clipboard actually receives cliptext
	A_Clipboard := Clip_All
	ClipLoop(duration, displaytext) ; Waits for the clipboard to receive the new text
}


DeleteClip(row_map) {
	focused_row := row_map["focused_ID"]
	row_numbers := row_map["ID_array"]
	row_keys := row_map["key_array"]

	For row_ID in row_numbers {
		row_key := row_keys[A_Index]

		Cliptionary.Delete(row_key) ; Deletes dictionary entry
		ClipListView.Delete(row_ID - A_Index + 1) ; Deletes LV row. The math accounts for the fact that each loop changes the actual row number of each subsequent deletion

		If row_ID = focused_row {
			focused_row := focused_row - A_Index + 1 ; Accounts for any previous selected rows that may be deleted
		}

	}
	ClipBarrelDestroyCheck() ; Destroys the GUI if ClipBarrel is empty
	LV_shrink() ; Resizes the LV
	Return focused_row
}


/**
 * Adjusts the icon shortcut key numbers after a row is deleted
 * @param row_num Int; row number at which to begin updating icons
 */
Update_Icons() {
	Global ClipListView
	Loop ClipListView.GetCount() {
		ClipListView.Modify(A_Index, "Icon" A_Index)
	}
}

; CLIPCOUNTER FUNCTIONS ===================================

/* Launches ClipCounter */
ClipCounter(A_ThisMenuItem := "", A_ThisMenuItemPos := "", A_ThisMenu := "") {
	Global
	ClipBarrelInitialize()
	ClipTabs.Value := 2
}


ClipCounter_Paste() {
	Global ClipCounter_Text
	full_message := ClipCounter_Text.Value

	; Removes the {braces} from the message
	Global ClipBarrel_Paste := RegExReplace(full_message, "[{}]", "", , 2)

	Load_Clipboard(ClipBarrel_Paste)
	Send("^v") ; Pastes
	ClipRestore()

	Global incrementBy
	countStep := incrementBy.Value
	RegExMatch(full_message, "{([^}]+)}", &currentCount) ; Load the current count value into currentCount

	currentCount := RegExReplace(currentCount[0], "[{}]", "", , 2) ; Retrieve match value, removing {}
	Switch incrementStyle.Value {
		Case 1: incrementedCount := currentCount + countStep
		Case 2: incrementedCount := clipLetters(currentCount, countStep, capitalized := True)
		Case 3: incrementedCount := clipLetters(currentCount, countStep)
	}

	ClipCounter_Text.Value := RegExReplace(full_message, "{([^}]+)}", "{" . incrementedCount . "}", , 1) ; Add the {} back in and increment the GUI text field

	ClipBarrel.Title := Format("ClipBarrel - ClipCounter: " incrementedCount, next_line)
}

/**
 * Increments ClipCount for letter cases
 * @param in_Letter Letter that is currently in the Edit box
 * @param incrementStep Amount to increment the step
 * @param capitalized Boolean
 * 
 */
clipLetters(in_Letter, incrementStep, capitalized := False) {
	countPos := InStr(alphabet, in_Letter) ; Finds position of in_Letter in the alphabet
	incrementedCount := countPos + incrementStep ; Increments the letter position
	If incrementedCount > 26 {
		incrementedCount -= 26 ; Wraps from z to a
	}
	out_Letter := SubStr(alphabet, incrementedCount, 1) ; Retrieves new letter
	If capitalized {
		out_Letter := StrUpper(out_Letter)
	}
	Return out_Letter
}


; =========================================================
; ClipBarrel GUI
; =========================================================
ClipBarrelInitialize() {
	Global
	TraySetIcon("HBITMAP:*" . Create_Image(ClipBarrel_B64_Icon, True))
	ClipBarrel := Gui(Format("+Owner +MinSize +Resize -MaximizeBox -MinimizeBox +LastFound"), "ClipBarrel - Next Line: ") ; +Owner avoids a taskbar button. We call MinSize twice, once to set default minX, again to set specific MinY

	; Style window ----------------------------------------
	ClipBarrel.SetFont(Format("s{}", fontPoint))

	; ClipTabs --------------------------------------------
	ClipTabs := ClipBarrel.Add("Tab3", Format("Section H{}", LineHeight + MarginY), [
		"ClipBarrel",
		"ClipCounter"
	])
	ClipTabs.GetPos(, &tab_y, &tab_width, &tab_height) ; Saves dimensions for later

	ClipTabs.UseTab(0)

	; Ghost -----------------------------------------------
	ghostBox := ClipBarrel.Add("CheckBox", , "Ghost on") ; XM positions it at the left edge of the margin
	ghost_state := ghostBox.Value := StreamRead("ClipBarrel", "ClipBarrel_ghost", False)
	ghostBox.GetPos(, , &ghost_width) ; Saving variables for later

	; Hover -----------------------------------------------
	hoverBox := ClipBarrel.Add("CheckBox", , "Hover on")
	hover_state := hoverBox.Value := StreamRead("ClipBarrel", "ClipBarrel_hover", True)
	hoverBox.GetPos(, , &hover_width) ; Saving variables for later

	; ClipBarrel ==========================================
	; Header LV -------------------------------------------
	; -LV0x10 prevents the user dragging the columns
	ClipHeader := ClipBarrel.Add("ListView", Format("Section XM ys+{} H{} -LV0x10 0x2000", tab_y + tab_height, lineHeight * 1.2
	), [
		" #",
		line_text_header "Copy order ↓"
	])
	ClipHeader.GetPos(, &Header_y)

	; ListView --------------------------------------------
	ClipListView := ClipBarrel.Add("ListView", Format("XM y+-1 List -ReadOnly"), [
		"Line text",
		"Key",
		"Stack Order"
	])

	ClipListView.GetPos(&LV_x, &LV_y, &LV_width, &LV_height)

	ClipListView.ModifyCol(1, "AutoHdr") ; AutoHdr fits column width to size of content and header width

	; Icons -----------------------------------------------
	ImageListID := IL_Create(10, , False) ; False means this creates Small icons

	icon_array := [
		Icon_1_B64,
		Icon_2_B64,
		Icon_3_B64,
		Icon_4_B64,
		Icon_5_B64,
		Icon_6_B64,
		Icon_7_B64,
		Icon_8_B64,
		Icon_9_B64,
		Icon_0_B64
	]

	For icon in icon_array {
		IL_Add(ImageListID, "HBITMAP:*" . Create_Image(icon, True))
	}

	ClipListView.SetImageList(ImageListID, 1) ; 0 sets this image list for Large icons, unless I dyslexia'd this

	; Buttons ---------------------------------------------
	dropButton := ClipBarrel.Add("Button", Format("Default"), "Drop line")
	dropButton.GetPos(&drop_x, , &drop_width, &drop_height) ; Saving variables for later

	splitButton := ClipBarrel.Add("Button", , "Split lines")
	splitButton.GetPos(, , &split_width, &split_height) ; Saving variables for later

	; CLIPCOUNTER =========================================
	ClipCounter_label := ClipBarrel.Add("Text", "xs ys Section Hidden",
		"Enter text to increment. Place the number inside the { }")
	ClipCounter_Text := ClipBarrel.Add("Edit", "w200 Hidden", "{1}") ; Display field for ClipCounter

	; incrementBy
	increment_label := ClipBarrel.Add("Text", "xm y+m Section Hidden", "Increment by:")
	incrementBy := ClipBarrel.Add("Edit", "x+m Hidden", "1") ; Display field for incrementBy

	style_label := ClipBarrel.Add("Text", "x+m Section Hidden", A_Tab "Counting style:")
	incrementStyle := ClipBarrel.Add("DropDownList", Format("x+m w{} Hidden Choose1", 8 * fontPoint), [
		"1, 2, 3...",
		"A, B, C...",
		"a, b, c..."
	])

	; Events ----------------------------------------------

	ClipBarrel.OnEvent("Size", Window_Resize)

	ClipTabs.OnEvent("Change", ClipTabs_Change)

	ghostBox.OnEvent("Click", ghostBox_Click)
	hoverBox.OnEvent("Click", hoverBox_Click)
	splitButton.OnEvent("Click", SplitLinesButton_Click)
	dropButton.OnEvent("Click", DropButton_Click)
	ClipHeader.OnEvent("ColClick", ClipHeader_Click)
	ClipHeader.OnEvent("ContextMenu", ClipHeader_ContextMenu)

	ClipListView.OnEvent("ContextMenu", ClipHeader_ContextMenu)
	ClipListView.OnEvent("DoubleClick", ClipListView_DoubleClick)
	ClipListView.OnEvent("ItemEdit", ClipListView_ItemEdit)
	ClipListView.OnEvent("ItemSelect", RetrieveSelectedRows)

	; Tabs don't support Lose/Focus
	ghostBox.OnEvent("Focus", Ghost_Off)
	hoverBox.OnEvent("Focus", Ghost_Off)
	splitButton.OnEvent("Focus", Ghost_Off)
	dropButton.OnEvent("Focus", Ghost_Off)
	ClipHeader.OnEvent("Focus", Ghost_Off)
	ClipListView.OnEvent("Focus", Ghost_Off)

	ClipCounter_Text.OnEvent("Focus", Ghost_Off)
	incrementBy.OnEvent("Focus", Ghost_Off)
	incrementStyle.OnEvent("Focus", Ghost_Off)

	ghostBox.OnEvent("LoseFocus", Ghost_On)
	hoverBox.OnEvent("LoseFocus", Ghost_On)
	splitButton.OnEvent("LoseFocus", Ghost_On)
	dropButton.OnEvent("LoseFocus", Ghost_On)
	ClipHeader.OnEvent("LoseFocus", Ghost_On)
	ClipListView.OnEvent("LoseFocus", Ghost_On)
	ClipCounter_Text.OnEvent("LoseFocus", Ghost_On)
	incrementBy.OnEvent("LoseFocus", Ghost_On)
	incrementStyle.OnEvent("LoseFocus", Ghost_On)

	incrementStyle.OnEvent("Change", Change_Counting_Style)

	ClipBarrel.OnEvent("Close", Save_Settings)

	; Dimensions ------------------------------------------

	xloc := StreamRead("ClipBarrel", "ClipBarrel_x", 0)
	yloc := StreamRead("ClipBarrel", "ClipBarrel_y", 0)

	ClipBarrel.Show(Format("Hide NoActivate X{} Y{}", xloc, yloc)) ; Shows the window hidden so we can get its width before showing it visibly

	DetectHiddenWindows True
	WinGetPos(, , &ClipBarrel_width, &ClipBarrel_height, "ClipBarrel - ") ; Can't use ClipBarrel.GetPos because of DPI scaling issues
	DetectHiddenWindows False

	LV_min := 3 * lineHeight
	minHeight := tab_height + LV_min + drop_height + 2 * MarginY + MarginX ; Should be three MarginYs, but it looks better to have the bottom margin be a marginX; final term is a calculation of button height

	; Window Launch ---------------------------------------
	If hover_state = True {
		ClipBarrel.Opt(Format("+AlwaysOnTop +MinSizex{}", minHeight))
	}
	Else ClipBarrel.Opt(Format("+MinSizex{}", minHeight))

	ClipListView.Focus() ; Receives focus so it doesn't default to the Tab, which can't take Lose/Focus events to apply Ghost. Has to be called before Ghost_On() or receiving focus will temporarily un-ghost until focus is lost again

	ClipBarrel.Show(Format("NoActivate X{} Y{} H{}", xloc, yloc, minHeight))

	Ghost_On() ; Ghosts if ghostBox.Value is set to True (Starts off False)

}

; =========================================================
; GUI FUNCTIONS/EVENTS
; =========================================================
Window_Resize(GuiObj := "", MinMax := "", Width := "", Height := "") {
	; Called whenever an LV item is added, the window is resized, or manually called
	Global
	ClipBarrel.GetClientPos(, , &ClipBarrel_width, &ClipBarrel_height)

	ClipTabs.Move(, , ClipBarrel_width - 2 * MarginX)

	ghostBox.Move(ClipBarrel_width - ghost_width * 2 - MarginX * 2, tab_y + MarginY / 2)
	hoverBox.Move(ClipBarrel_width - ghost_width - MarginX, tab_y + MarginY / 2)

	dropButton.Move(ClipBarrel_width - ghost_width - MarginX, Header_y, split_width)
	splitButton.Move(ClipBarrel_width - ghost_width - MarginX, Header_y + drop_height + MarginY)

	; Size LV to fill available space
	ClipListView.Move(, , ClipBarrel_width - drop_width - 3 * MarginX, ClipBarrel_height - tab_height - 4 * MarginY -
		lineHeight) ; Height should be -3MarginY, but it looks better if one's a MarginX
	ClipListView.ModifyCol(2, "AutoHdr") ; AutoHdr fits column width to size of content and header width
	ClipListView.GetPos(, &LV_y, &LV_width, &LV_height)

	ClipHeader.Move(, , LV_width) ; Sizes the header width to match the LV
	ClipHeader.ModifyCol(2, LV_width) ; Sizes the second column so the header is wider than the LV, so the last column can't be resized

	; Update next line in title
	Try {
		select_line := Max(ClipListView.GetNext(), 1) ; This will fail on GUI creation since there are no lines to return
		next_line := ClipListView.GetText(select_line, 1)
		ClipBarrel.Title := Format("ClipBarrel - Next Line: {}", next_line)
	}
}

/**
 * Changes brace value based on Counting Style
 * ; TODO: Add data validation, character limits, etc.
 */
Change_Counting_Style(GuiObj := "", MinMax := "", Width := "", Height := "") {
	counter_message := ClipCounter_Text.Value
	Switch incrementStyle.Value {
		Case 1:
		{
			; Numeric counting style
			counter_message := RegExReplace(counter_message, "{([^}]+)}", "{1}")
			ClipBarrel.Title := "ClipBarrel - ClipCounter: 1"
		}
		Case 2:
		{
			; Capital letter counting style
			counter_message := RegExReplace(counter_message, "{([^}]+)}", "{A}")
			ClipBarrel.Title := "ClipBarrel - ClipCounter: A"
		}
		Case 3:
		{
			; Lowercase letter counting style
			counter_message := RegExReplace(counter_message, "{([^}]+)}", "{a}")
			ClipBarrel.Title := "ClipBarrel - ClipCounter: a"
		}
	}
	ClipCounter_Text.Value := counter_message
}

/**
 * Saves GUI location and settings
 */
Save_Settings(GuiObj := "", MinMax := "", Width := "", Height := "") {
	Global
	ClipBarrel.GetPos(&clip_x, &clip_y)
	StreamWrite("ClipBarrel", "ClipBarrel_x", clip_x)
	StreamWrite("ClipBarrel", "ClipBarrel_y", clip_y)
	StreamWrite("ClipBarrel", "ClipBarrel_hover", hover_state)
	StreamWrite("ClipBarrel", "ClipBarrel_ghost", ghost_state)
}


/**
 * Checks if the barrel is empty and destroys the GUI if it is
 */
ClipBarrelDestroyCheck() {
	Global
	If ClipListView.GetCount() = 0 {
		ClipBarrel_Destroy()
	}
}

/**
 * Detroys the GUI if ClipBarrel is empty
 */
ClipBarrel_Destroy(ExitReason := "", ExitCode := "") {
	Global ClipListView
	Save_Settings()
	ClipListView.Delete()
	ClipBarrel.Destroy() ; Destroys the GUI
	Global Cliptionary := Map() ; Frees any remaining contents
	ClipRestore()
	Exit
}
/**
 * Shows/hides ClipBarrel/ClipCounter objects on tab change
 * Objects aren't actually in the tab object because I've heard of issues with having LVs in Tabs.
 */
ClipTabs_Change(GuiCtrlObj, Info) {
	Global
	selected_tab := ClipTabs.Value
	If selected_tab = 2 { ; ClipCounter tab
		splitButton.Visible := False
		dropButton.Visible := False
		ClipHeader.Visible := False
		ClipListView.Visible := False

		ClipCounter_label.Visible := True
		ClipCounter_Text.Visible := True
		increment_label.Visible := True
		incrementBy.Visible := True
		style_label.Visible := True
		incrementStyle.Visible := True

		ClipCounter_Text.Value := ClipListView.GetText(1) . "{1}" ; Loads the top entry in ClipBarrel as the prefix for ClipCounter's number
		ClipCounter_Text.Focus()

		ClipBarrel.Title := Format("ClipBarrel - ClipCounter: {}", incrementBy.Value)
	}
	Else {
		ClipCounter_label.Visible := False
		ClipCounter_Text.Visible := False
		increment_label.Visible := False
		incrementBy.Visible := False
		style_label.Visible := False
		incrementStyle.Visible := False

		splitButton.Visible := True
		dropButton.Visible := True
		ClipHeader.Visible := True
		ClipListView.Visible := True

		ClipListView.Focus()

		next_line := ClipListView.GetText(ClipListView.GetNext(), 1)
		ClipBarrel.Title := Format("ClipBarrel - Next Line: {}", next_line)
	}
}

; Checkboxes ----------------------------------------------
ghostBox_Click(btn, info) {
	Global
	ghost_state := ghostBox.Value
}

Ghost_On(*) {
	Global
	If (ghost_state = True) {
		Try {
			WinSetTransparent transparency_level, "ClipBarrel - "
		}
	}
}

Ghost_Off(*) {
	Global
	Try { ; Try prevents an error when the GUI is closed
		WinSetTransparent "Off", "ClipBarrel - "
	}
}

hoverBox_Click(this_gui_ctrl, info) {
	Global
	WinSetAlwaysOnTop -1, "ClipBarrel - " ; -1 toggles True/False
	hover_state := hoverBox.Value
}

; ClipBarrel Buttons --------------------------------------
DropButton_Click(this_gui_ctrl, info) {
	; Removes the next/selected item from the ClipBarrel and selects the row after the focused row
	selected_row_data := RetrieveSelectedRows()
	row_to_focus := DeleteClip(selected_row_data)

	Select_row(row_to_focus)
}

reset_sort() {
	Global
	is_sorted := False ; Resets Copy Order when new lines are added
	copy_reverse := True
	alpha_reverse := False
}

SplitLinesButton_Click(this_gui_ctrl, info) {
	; Seperates each paragraph of text into its own ClipBarrel entry. Does lose any text formatting
	Global
	reset_sort()
	row_count := ClipListView.GetCount()
	split_array := []

	Loop row_count {
		row_text := ClipListView.GetText(A_Index, 1)
		old_key := ClipListView.GetText(A_Index, 2)

		If RegExMatch(row_text, "^\{object: ") {
			; For non-text objects, adds them to split_array unedited
			object_key := ClipListView.GetText(A_Index, 2)
			split_array.Push(object_key)
			Continue
		}
		Else If InStr(row_text, A_return) = 0 {
			; For single-line objects, adds them to split_array unedited
			object_key := ClipListView.GetText(A_Index, 2)
			split_array.Push(object_key)
			Continue
		}
		Else {
			; Split text objects by paragraph, consequently losing any font formatting
			replaced_row := row_text ; I think operating directly on row_text forgets the changes in each loop
			Loop {
				FoundPos := RegExMatch(replaced_row, "^.+?([`r`n])+", &line_match) ; Match the first line/paragraph and save the text in line_match as a Match object
				If FoundPos = 0 {
					line_text := replaced_row ; If no further matches found, return the final line
				}
				Else {
					line_text := line_match[0] ; Extract the text from the Match object
				}

				replaced_row := StrReplace(replaced_row, line_text, "", , , 1) ; Remove line_text from the rest of the row's text
				line_key := old_key A_index ; Create a unique key value
				split_array.Push(line_key) ; Add the key to the array to be added to the LV in LoadClipBarrelLV
				; Add the line as both the clip_text and clip_all, despite not having formatting, to the string's key
				Cliptionary[line_key] := {
					clip_text: line_text,
					clip_all: line_text
				}

				If replaced_row = "" { ; Break the loop after the last line is processed
					Break
				}
			}
		}
		Cliptionary.Delete(old_key) ; Removes existing row
	}
	ClipListView.Delete() ; Deletes the existing list
	LoadClipBarrelLV(split_array) ; Adds each line back to the ClipBarrel
}


sort_ClipBarrel(sort_mode := "alpha") {
	; Sets Copied Order in order to re-sort to, assuming it wasn't already set in a previous sort
	Global is_sorted
	If not is_sorted {
		Loop ClipListView.GetCount() {
			ClipListView.Modify(A_Index, "Col3", A_Index)
		}
	}

	Switch sort_mode {
		Case "alpha": ClipListView.ModifyCol(1, "Sort Logical")
		Case "alpha_reverse": ClipListView.ModifyCol(1, "SortDesc Logical")
		Case "copied": ClipListView.ModifyCol(3, "Sort")
		Case "copied_reverse": ClipListView.ModifyCol(3, "SortDesc")
	}
	; Prevents further sorting from becoming the "new" Copied order
	is_sorted := True
	Update_Icons()
}


; ClipBarrel LV Events ------------------------------------
ClipHeader_Click(ClipHeader, col_num) {
	Global ClipListView
	ClipListView.Modify(0, "-Select -Focus")
	If col_num = 1 {
		Global copy_reverse
		If copy_reverse {
			sort_ClipBarrel("copied_reverse")
			ClipHeader.ModifyCol(2, , line_text_header "Copy order ↑")
		}
		Else {
			sort_ClipBarrel("copied")
			ClipHeader.ModifyCol(2, , line_text_header "Copy order ↓")
		}
		copy_reverse := !copy_reverse
	}
	Else { ; Sort alphabetically if the Line Text column header is clicked
		Global alpha_reverse
		If alpha_reverse {
			sort_ClipBarrel("alpha_reverse")
			ClipHeader.ModifyCol(2, , line_text_header "Alpha order ↑")
		}
		Else {
			sort_ClipBarrel("alpha")
			ClipHeader.ModifyCol(2, , line_text_header "Alpha order ↓")
		}
		alpha_reverse := !alpha_reverse
	}
}

ClipHeader_ContextMenu(ClipHeader, menu_item, *) {
	; Create context menu
	sort_menu := Menu()
	sort_menu.add("Alphabetical", menu_item_number)
	sort_menu.add("Reverse alphabetical", menu_item_number)
	sort_menu.add("Order copied", menu_item_number)
	sort_menu.add("Reverse order copied", menu_item_number)
	sort_menu.show()

	; Perform selected sort
	menu_item_number(item_name, item_position, *) {
		Switch item_position {
			Case 1: sort_ClipBarrel("alpha")
			Case 2: sort_ClipBarrel("alpha_reverse")
			Case 3: sort_ClipBarrel("copied")
			Case 4: sort_ClipBarrel("copied_reverse")
		}
	}
}


ClipListView_DoubleClick(ClipListView, LV_line_num) {
	ControlSend "{F2}", "SysListView322", "ClipBarrel - Next Line: "
}

/**
 * When the user edits an item, updates Cliptionary with the edited text. Loses non-text content
 * @param ClipListView ClipList's LV object
 * @param LV_line_num Int
 */
ClipListView_ItemEdit(ClipListView, LV_line_num) {
	Cliptionary[ClipListView.GetText(LV_line_num, 2)].clip_all := ClipListView.GetText(LV_line_num, 1)
}

LV_Grow() {
	; Grows the GUI when an LV item is added. Won't grow beyond the LV_max, but will allow manual resizing for larger than that
	Global
	ClipListView.GetPos(, , , &current_LV_height)

	If (current_LV_height < LV_max) { ; Won't automatically grow past 10 rows

		this_LV_height := Min(ClipListView.GetCount(), 10) * lineHeight + headerHeight ; If we've added over 10 items, will only grow to show 10

		ClipBarrel.Show("NoActivate H" . this_LV_height + 2 * MarginY + MarginX + drop_height)
	}
	Update_Icons()
	Window_Resize()
}

LV_Shrink() {
	; Shrinks the GUI when an LV item is removed
	Global
	ClipBarrel.GetClientPos(, , , &ClipBarrel_height)
	ClipListView.GetPos(, , , &current_LV_height)

	; Won't shrink the window if there are lines out of view, IE, if there's a scroll bar. Adding a bonus lineHeight seems to work better?
	If ((ClipListView.GetCount() + 1) * lineHeight + headerHeight) < current_LV_height {
		ClipBarrel.Show("NoActivate H" . ClipBarrel_height - lineHeight) ; Shrinks by 1 line height
	}
	Update_Icons()
	Window_Resize()
}


